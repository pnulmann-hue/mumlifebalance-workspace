# PIA-Bot — Umgebungsvariablen
# Kopiere diese Datei zu .env und fülle die Werte aus.
# .env ist gitignored — Tokens landen NIE im Git.

# Telegram-Bot-Token (NEUER Bot via @BotFather — NICHT der Story-Bot-Token!)
PIA_BOT_TOKEN=

# Anthropic Claude API
ANTHROPIC_API_KEY=
# optional: Modell überschreiben (Default claude-opus-4-8)
# PIA_CLAUDE_MODEL=claude-opus-4-8

# OpenAI (optional — nur für Sprachnotiz-Transkription)
OPENAI_API_KEY=

# optional: Patricia-Chat-ID für /admin-Statistik + Fehler-Pings
PIA_ADMIN_CHAT_ID=

# optional: Bootcamp-Gruppenlink (Default ist gesetzt)
# PIA_GRUPPE_LINK=https://t.me/+HW6lvdlbTBhiOWM0
