# Anthropic API Key (fuer den Produkt-Ideen-Finder)
ANTHROPIC_API_KEY=sk-ant-...

# --- ab hier nur noch fuer die alte Chat-Version (_archiv-chat-version/) ---
# Das Formular fragt keine E-Mail mehr ab: die Leads kommen ueber das
# ManyChat-Keyword STANDBEIN, bevor jemand den Link bekommt.

# ActiveCampaign API (Lead-Capture)
AC_API_URL=https://mumlifebalance.api-us1.com
AC_API_KEY=

# AC Liste, in die neue Leads eingetragen werden
# 2 = "Regulärer Newsletter/Interessenten"
AC_LIST_ID=2

# AC Tag fuer Tool-Leads — Tag "produkt-ideen-finder-lead" (angelegt 2026-09-04)
AC_TAG_LEAD=98

# Checkout-URL des 39er-Minikurs "Vom Network-Wissen zum eigenen Produkt"
# Im Formular steht der Link in public/app.js (KURS_LINK), nicht hier.
MINIKURS_URL=https://mumlifebalance.thrivecart.com/eigene-produkterstellung/
