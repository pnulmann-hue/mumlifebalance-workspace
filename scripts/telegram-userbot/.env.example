# Telegram API Credentials (von my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Wird nach dem ersten Login ausgefüllt
TELEGRAM_SESSION=

# Patricias Telegram User ID (wird beim ersten /start in Supabase gespeichert)
# Muss hier für Railway-Deployment bekannt sein
PATRICIA_TELEGRAM_USER_ID=

# Bot-Token für DM-Benachrichtigungen (derselbe wie im doterra-bot)
NOTIFICATION_BOT_TOKEN=

# Supabase (gleich wie doterra-bot)
SUPABASE_URL=https://mpozijbocbepijdedppi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# OpenAI (für Embeddings)
OPENAI_API_KEY=

# Business-Gruppen IDs (Komma-getrennt, wird spaeter dynamisch via DM erweitert)
# Leer lassen = alle Gruppen monitoren
MONITORED_CHAT_IDS=

# ── Mail-Sweep (IMAP, 3 Postfächer) ────────────────────────────────
MAILASSISTANT_BOT_TOKEN=
GMX_IMAP_HOST=imap.gmx.net
GMX_IMAP_PORT=993
GMX_IMAP_USER=
GMX_IMAP_PASS=
HOSTSTAR_IMAP_HOST=lx30.hoststar.hosting
HOSTSTAR_IMAP_PORT=143
HOSTSTAR_IMAP_USER=
HOSTSTAR_IMAP_PASS=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_USER=
GMAIL_IMAP_PASS=

# ── Bot-Einspeisung aus Mails (optional — inaktiv wenn leer) ────────
# Garten-Mails → Notion-Wissensarchiv (+ Garten-RAG). Token aus garten-telegram-bot.
NOTION_TOKEN=
NOTION_WISSENSARCHIV_DS=3497078e-8b7e-81e4-b974-e1f6a91d2064
GARTEN_SUPABASE_URL=
GARTEN_SUPABASE_KEY=
# Rezept-Mails → Kochbot-RAG. NUR setzen mit dem KOCHBOT-Supabase-Projekt
# (≠ doTERRA/Garten-Projekt!). Ohne diese Werte werden Rezepte nur lokal
# nach outputs/kochbot-eingang/ gestaged.
KOCHBOT_SUPABASE_URL=
KOCHBOT_SUPABASE_KEY=
