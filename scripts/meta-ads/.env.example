# Meta (Facebook) Marketing API + Ad Library API
# Setup-Anleitung siehe README.md

# System User Token aus dem Meta Business Manager (nicht verwechseln mit User Access Token!)
# Hol dir den hier: Business Manager → Business Einstellungen → System-Benutzer → Token generieren
# Permissions: ads_read, ads_management, business_management, pages_read_engagement
META_ACCESS_TOKEN=EAAxxxxxxxxxxx

# Ad Account ID — zu finden im Ads Manager in der URL: act_1234567890
# Format IMMER mit 'act_' Prefix
META_AD_ACCOUNT_ID=act_1234567890

# Optional - fuer App-spezifische Aufrufe
META_APP_ID=
META_APP_SECRET=

# Waehrung fuer Reporting (nur Anzeige, Meta selbst nutzt Account-Waehrung)
META_CURRENCY=CHF
