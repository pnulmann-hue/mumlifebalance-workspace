# ManyChat API Zugangsdaten
# Kopier diese Datei zu .env und trage deinen echten API-Key ein
# Die .env-Datei wird NIEMALS auf GitHub hochgeladen (via .gitignore)

# Get your API key from:
# ManyChat → Settings → API → Generate API Key (Pro-Plan erforderlich)
MANYCHAT_API_KEY=your-api-key-here

# Page-ID deiner Instagram/Facebook-Page (wird vom Key automatisch abgeleitet,
# aber nützlich für Multi-Page-Accounts)
MANYCHAT_PAGE_ID=optional
