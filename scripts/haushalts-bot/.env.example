# Haushalts-Bot — lokale Test-Konfiguration (NICHT committen, .env ist gitignored)
# In GitHub Actions kommen diese Werte aus Repo-Secrets.

# Eigener Telegram-Bot (via @BotFather angelegt) — NICHT der Cockpit-Bot
# Format: <zahlen>:<buchstaben-mix> — hier nur Platzhalter eintragen
TELEGRAM_HAUSHALT_BOT_TOKEN=DEIN_BOTFATHER_TOKEN_HIER
TELEGRAM_HAUSHALT_CHAT_ID=DEINE_CHAT_ID_HIER

# Notion-Integration mit Zugriff auf die "🏠 Haushalts-Liste"
NOTION_TOKEN=DEIN_NOTION_TOKEN_HIER
