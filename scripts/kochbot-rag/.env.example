# Supabase-Projekt (Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NICHT der anon key — service_role hat Schreibrechte)

# OpenAI (fuer Embeddings — text-embedding-3-small, sehr guenstig)
OPENAI_API_KEY=sk-...

# Optional: Schwellenwert fuer Vector-Search-Treffer (0.0-1.0, default 0.3)
# MATCH_THRESHOLD=0.3
