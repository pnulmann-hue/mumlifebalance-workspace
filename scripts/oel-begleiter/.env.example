# Öl-Begleiter — Umgebungsvariablen
# Kopiere diese Datei zu .env und fülle die Werte aus.
# .env ist gitignored — Tokens landen NIE im Git.

# Telegram-Bot-Token (NEUER Bot via @BotFather — NICHT der Story-/PIA-Bot-Token!)
OEL_BOT_TOKEN=

# Anthropic Claude API (für die Etappen-Texte)
ANTHROPIC_API_KEY=
# optional: Modell überschreiben (Default claude-opus-4-8)
# OEL_CLAUDE_MODEL=claude-opus-4-8

# --- Companion-Wissensbasis (DAS Öl-Wissen, auf das deine Kundinnen Zugriff haben) ---
# Dieselben Supabase-Zugangsdaten wie beim doTERRA-Companion (doterra-bot).
# Der Bot liest daraus documents mit category="product" (Enjoils + Produktwissen).
# Fehlen sie, läuft der Bot weiter, macht dann aber KEINE konkreten Öl-Aussagen.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Alternativ akzeptiert: SUPABASE_SERVICE_ROLE_KEY

# OpenAI (optional — nur für Sprachnotiz-Transkription der Testerinnen)
OPENAI_API_KEY=

# optional: Patricia-Chat-ID für /admin-Statistik
OEL_ADMIN_CHAT_ID=

# optional: Tages-Push-Uhrzeit (Stunde, lokal) + Zeitzone — Default 08:00 Europe/Zurich
# OEL_SEND_HOUR=8
# OEL_TIMEZONE=Europe/Zurich

# optional: Wie Testerinnen am Ende (Tag 7) Kontakt für ihre Hausapotheke aufnehmen
# OEL_PATRICIA_KONTAKT=schreib mir hier einfach HAUSAPOTHEKE, dann melde ich mich bei dir
