# Pflicht
ANTHROPIC_API_KEY=sk-ant-...

# Zugangscodes der Kaeuferinnen, Komma-getrennt.
# Leer lassen = offen fuer alle (nur fuer deine eigenen Tests).
ZUGANGSCODES=STARTKLAR-A1,STARTKLAR-A2

# Optional: eigener Kontakt-Satz fuer Stoerungsmeldungen.
# Standard: "Sag Patricia bitte kurz Bescheid, dass das hier gerade nicht ging."
# Trag hier ein, wie du erreichbar sein willst (DM, Mail, was auch immer).
KONTAKT_HINWEIS=

# Optional: zusaetzliche erlaubte Herkunft (Komma-Liste), z.B. eine Testdomain
ERLAUBTE_HERKUNFT=

# Optional: harte Obergrenze pro Code. Greift nur mit KV-Speicher.
MAX_PRUEFUNGEN=150
KV_REST_API_URL=
KV_REST_API_TOKEN=
