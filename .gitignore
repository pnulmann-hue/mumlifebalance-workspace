context/Kurse/**/*.m4v
context/Kurse/**/*.mov
context/Kurse/**/*.webm
context/Kurse/**/*.avi
context/Kurse/**/*.mkv
context/Kurse/**/*.m4a
context/Kurse/**/*.mp3
context/Kurse/**/*.wav
context/Kurse/**/*.zip
context/Kurse/**/*.png
context/Kurse/**/*.jpg
context/Kurse/**/*.jpeg
context/Kurse/**/*.JPG
context/Kurse/**/*.PNG

# Julia-Trost-PDFs zu gross (40+ PDFs × mehrere MB)
# Content in Transkripten als .txt ist ausreichend
reference/julia-trost/*.pdf
reference/julia-trost/*.xlsx
reference/julia-trost/*.jpeg
reference/julia-trost/*.docx

# Transkript-Duplikate (VTT/SRT/JSON/TSV sind Doppelungen von .txt)
reference/julia-trost/Transkripte Videocalls/*.vtt
reference/julia-trost/Transkripte Videocalls/*.srt
reference/julia-trost/Transkripte Videocalls/*.tsv
reference/julia-trost/Transkripte Videocalls/*.json

# Private Non-Business-Ordner
kochwissen/
rezepte/
result.txt

# Logo-Files (grosse Varianten)
context/MumLifeBalance-Logo/**/*.otf
context/Farbcodes.png
context/Nutzung Schriftarten.png

